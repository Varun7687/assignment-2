            "tags_all": {
              "ManagedBy": "terraform",
              "Name": "northwind-reporting-server",
              "Project": "northwind-reporting",
              "Role": "reporting"
            },
            "tenancy": "default",
            "timeouts": null,
            "user_data": "#!/bin/bash\nset -euxo pipefail\n\t\nPROJECT_DIR=\"/home/ec2-user/northwind-reporting\"\nSCRIPT_PATH=\"$PROJECT_DIR/generate_report.sh\"\nTEMPLATE_PATH=\"$PROJECT_DIR/report.html.template\"\nLOG_PATH=\"$PROJECT_DIR/generate_report.log\"\n\t\nmkdir -p \"$PROJECT_DIR\"\ncat \u003e \"$TEMPLATE_PATH\" \u003c\u003c'REPORT_HTML_TEMPLATE'\n\u003c!doctype html\u003e\n\u003chtml lang=\"en\"\u003e\n\u003chead\u003e\n  \u003cmeta charset=\"utf-8\"\u003e\n  \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1\"\u003e\n  \u003ctitle\u003eNorthwind Sales Report\u003c/title\u003e\n  \u003cstyle\u003e\n    :root { --navy:#12324a; --blue:#1778a8; --light:#eef5f8; --muted:#627786; --line:#d8e2e8; --green:#18815b; }\n    * { box-sizing: border-box; }\n    body { margin:0; background:#f3f7f9; color:#173042; font-family:Arial,Helvetica,sans-serif; }\n    .page { max-width:920px; margin:32px auto; padding:0 20px; }\n    .report { background:#fff; border:1px solid var(--line); border-radius:14px; overflow:hidden; box-shadow:0 8px 24px rgba(18,50,74,.08); }\n    header { background:linear-gradient(135deg,var(--navy),#1c607d); color:#fff; padding:28px 32px; }\n    h1 { margin:0 0 8px; font-size:30px; letter-spacing:.2px; }\n    header p { margin:0; color:#d9edf5; font-size:15px; }\n    .notice { margin:0; padding:12px 32px; background:#f1fbf7; color:#176044; border-bottom:1px solid #cbe9dc; font-size:13px; }\n    .content { padding:28px 32px 32px; }\n    .metrics { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:28px; }\n    .metric { background:var(--light); border:1px solid #dbeaf0; border-radius:10px; padding:18px; }\n    .metric-label { color:var(--muted); font-size:13px; text-transform:uppercase; letter-spacing:.7px; }\n    .metric-value { margin-top:7px; color:var(--navy); font-size:28px; font-weight:700; }\n    .columns { display:grid; grid-template-columns:1fr 1fr; gap:28px; }\n    h2 { color:var(--navy); font-size:19px; margin:0 0 12px; }\n    table { width:100%; border-collapse:collapse; font-size:14px; }\n    th, td { padding:11px 8px; border-bottom:1px solid var(--line); text-align:left; }\n    th:last-child, td:last-child { text-align:right; }\n    th { color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:.5px; }\n    .footer { margin-top:28px; padding-top:18px; border-top:1px solid var(--line); color:var(--muted); font-size:13px; line-height:1.6; }\n    .status { color:var(--green); font-weight:700; }\n    @media (max-width:680px) { .metrics,.columns { grid-template-columns:1fr; } .content,header { padding-left:20px; padding-right:20px; } }\n  \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n  \u003cmain class=\"page\"\u003e\n    \u003carticle class=\"report\"\u003e\n      \u003cheader\u003e\n        \u003ch1\u003eNorthwind Sales Report\u003c/h1\u003e\n        \u003cp\u003eNightly sample report | Reporting date: __REPORT_DATE__\u003c/p\u003e\n      \u003c/header\u003e\n      \u003cdiv class=\"notice\"\u003eFICTIONAL SAMPLE DATA — for AWS upload testing only; not actual Northwind financial information.\u003c/div\u003e\n      \u003csection class=\"content\"\u003e\n        \u003cdiv class=\"metrics\"\u003e\n          \u003cdiv class=\"metric\"\u003e\u003cdiv class=\"metric-label\"\u003eTotal sales\u003c/div\u003e\u003cdiv class=\"metric-value\"\u003e$16,851.25\u003c/div\u003e\u003c/div\u003e\n          \u003cdiv class=\"metric\"\u003e\u003cdiv class=\"metric-label\"\u003eOrders\u003c/div\u003e\u003cdiv class=\"metric-value\"\u003e142\u003c/div\u003e\u003c/div\u003e\n          \u003cdiv class=\"metric\"\u003e\u003cdiv class=\"metric-label\"\u003eAverage order value\u003c/div\u003e\u003cdiv class=\"metric-value\"\u003e$118.67\u003c/div\u003e\u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"columns\"\u003e\n          \u003csection\u003e\n            \u003ch2\u003eSales by region\u003c/h2\u003e\n            \u003ctable\u003e\n              \u003cthead\u003e\u003ctr\u003e\u003cth\u003eRegion\u003c/th\u003e\u003cth\u003eOrders\u003c/th\u003e\u003cth\u003eSales\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\n              \u003ctbody\u003e\n                \u003ctr\u003e\u003ctd\u003eNorth America\u003c/td\u003e\u003ctd\u003e78\u003c/td\u003e\u003ctd\u003e$8,420.50\u003c/td\u003e\u003c/tr\u003e\n                \u003ctr\u003e\u003ctd\u003eEurope\u003c/td\u003e\u003ctd\u003e41\u003c/td\u003e\u003ctd\u003e$5,180.00\u003c/td\u003e\u003c/tr\u003e\n                \u003ctr\u003e\u003ctd\u003eAsia Pacific\u003c/td\u003e\u003ctd\u003e23\u003c/td\u003e\u003ctd\u003e$3,250.75\u003c/td\u003e\u003c/tr\u003e\n                \u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eTotal\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003e\u003cstrong\u003e142\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003e\u003cstrong\u003e$16,851.25\u003c/strong\u003e\u003c/td\u003e\u003c/tr\u003e\n              \u003c/tbody\u003e\n            \u003c/table\u003e\n          \u003c/section\u003e\n          \u003csection\u003e\n            \u003ch2\u003eSales by product category\u003c/h2\u003e\n            \u003ctable\u003e\n              \u003cthead\u003e\u003ctr\u003e\u003cth\u003eCategory\u003c/th\u003e\u003cth\u003eSales\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\n              \u003ctbody\u003e\n                \u003ctr\u003e\u003ctd\u003eOutdoor\u003c/td\u003e\u003ctd\u003e$6,420.50\u003c/td\u003e\u003c/tr\u003e\n                \u003ctr\u003e\u003ctd\u003eHome Goods\u003c/td\u003e\u003ctd\u003e$6,180.75\u003c/td\u003e\u003c/tr\u003e\n                \u003ctr\u003e\u003ctd\u003eAccessories\u003c/td\u003e\u003ctd\u003e$4,250.00\u003c/td\u003e\u003c/tr\u003e\n              \u003c/tbody\u003e\n            \u003c/table\u003e\n          \u003c/section\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"footer\"\u003e\n          Prepared by: Sample reporting job | Distribution: Finance team | Status: \u003cspan class=\"status\"\u003eComplete\u003c/span\u003e\u003cbr\u003e\n          Reporting host: __REPORT_HOST__ | Root disk usage: __DISK_USAGE__\u003cbr\u003e\n          S3 object key: __REPORT_KEY__\n        \u003c/div\u003e\n      \u003c/section\u003e\n    \u003c/article\u003e\n  \u003c/main\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n\nREPORT_HTML_TEMPLATE\n\t\ncat \u003e \"$SCRIPT_PATH\" \u003c\u003c'REPORT_SCRIPT'\n#!/usr/bin/env bash\nset -euo pipefail\numask 027\n\t\nexport PATH=\"/usr/local/bin:/usr/bin:/bin\"\nAWS_REGION=\"us-east-1\"\nREPORT_BUCKET=\"northwind-reporting-reports-assignment-02\"\nSNS_TOPIC_ARN=\"arn:aws:sns:us-east-1:243772032585:nightly-report-ready-assignment-02\"\nTEMPLATE_PATH=\"/home/ec2-user/northwind-reporting/report.html.template\"\n\t\nRUN_ID=\"$(date -u +'%Y-%m-%dT%H-%M-%S')-$$\"\nREPORT_KEY=\"reports/${RUN_ID}.html\"\nREPORT_FILE=\"$(mktemp /tmp/northwind-report.XXXXXX.html)\"\ntrap 'rm -f \"$REPORT_FILE\"' EXIT\n\t\nREPORT_DATE=\"$(date -u +'%d %B %Y')\"\nREPORT_HOST=\"$(hostname)\"\nDISK_USAGE=\"$(df -h / | awk 'NR==2 {print $5 \" used of \" $2}')\"\n\t\nsed \\\n  -e \"s|__REPORT_DATE__|$REPORT_DATE|g\" \\\n  -e \"s|__REPORT_HOST__|$REPORT_HOST|g\" \\\n  -e \"s|__DISK_USAGE__|$DISK_USAGE|g\" \\\n  -e \"s|__REPORT_KEY__|$REPORT_KEY|g\" \\\n  \"$TEMPLATE_PATH\" \u003e \"$REPORT_FILE\"\n\t\naws s3 cp \"$REPORT_FILE\" \"s3://${REPORT_BUCKET}/${REPORT_KEY}\" \\\n  --region \"$AWS_REGION\" \\\n  --sse AES256 \\\n  --content-type \"text/html\" \\\n  --only-show-errors\n\t\nPRESIGNED_URL=\"$(aws s3 presign \"s3://${REPORT_BUCKET}/${REPORT_KEY}\" \\\n  --expires-in 3600 \\\n  --region \"$AWS_REGION\")\"\n\t\nprintf -v SNS_MESSAGE 'Report uploaded to s3://%s/%s.\\n\\nDownload link valid for approximately 1 hour:\\n%s' \\\n  \"$REPORT_BUCKET\" \"$REPORT_KEY\" \"$PRESIGNED_URL\"\n\t\naws sns publish \\\n  --topic-arn \"$SNS_TOPIC_ARN\" \\\n  --subject \"Northwind report ready\" \\\n  --message \"$SNS_MESSAGE\" \\\n  --region \"$AWS_REGION\" \\\n  \u003e/dev/null\n\t\nprintf 'Uploaded HTML report: s3://%s/%s\\n' \"$REPORT_BUCKET\" \"$REPORT_KEY\"\nprintf 'SNS notification sent with a temporary download link.\\n'\nREPORT_SCRIPT\n\t\nchmod 750 \"$SCRIPT_PATH\"\nchmod 640 \"$TEMPLATE_PATH\"\nchown -R ec2-user:ec2-user \"$PROJECT_DIR\"\n\t\ndnf install -y cronie\nsystemctl enable --now crond\n\t\ncat \u003e /etc/cron.d/northwind-reporting \u003c\u003cCRON\nSHELL=/bin/bash\nPATH=/usr/local/bin:/usr/bin:/bin\n0 0 * * * ec2-user AWS_REGION=us-east-1 REPORT_BUCKET=northwind-reporting-reports-assignment-02 SNS_TOPIC_ARN=arn:aws:sns:us-east-1:243772032585:nightly-report-ready-assignment-02 ${SCRIPT_PATH} \u003e\u003e ${LOG_PATH} 2\u003e\u00261\nCRON\nchmod 644 /etc/cron.d/northwind-reporting\n",
            "user_data_base64": null,
            "user_data_replace_on_change": false,
            "volume_tags": null,
